@layer components {
  /* 1. Liquid Glass Base (For layout cards, tables, panels) */
  .liquid-glass {
    @apply bg-[#080A10]/80 backdrop-blur-xl border border-white/[0.04] rounded-[32px] shadow-xl;
  }

  /* 2. Unified Form Inputs (For text fields, dropdowns, dates) */
  .input-glass {
    @apply w-full bg-white/[0.02] border border-white/[0.08] rounded-2xl px-3.5 py-2.5 text-xs text-white placeholder:text-white/30 focus:border-[#FF9F0A]/50 focus:bg-white/[0.05] transition-all outline-none font-medium;
  }

  /* 3. Primary Action Buttons (The glowing orange signature button) */
  .btn-orange-glow {
    @apply bg-[#FF9F0A] text-black font-bold tracking-wide transition-all shadow-[0_0_15px_rgba(255,159,10,0.3)] hover:shadow-[0_0_25px_rgba(255,159,10,0.5)] hover:scale-[1.02] active:scale-95;
  }

  /* 4. Secondary Action Buttons (For cancel/clear actions) */
  .btn-glass {
    @apply bg-white/[0.03] hover:bg-white/[0.08] border border-white/[0.08] text-white transition-all active:scale-95;
  }

  /* 5. Fluid Animations (Universal smooth transitions) */
  .ios-spring {
    @apply transition-all duration-300 ease-out;
  }
}

